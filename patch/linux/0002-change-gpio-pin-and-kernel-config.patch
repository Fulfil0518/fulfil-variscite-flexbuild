From 48de14d0217a927df60fda370339c3bfece38e5a Mon Sep 17 00:00:00 2001
From: Kevin Jesubalan <kevin.jesubalan@fulfil.com>
Date: Mon, 26 Jan 2026 19:38:33 -0800
Subject: [PATCH] change gpio pin and kernel config

---
 arch/arm64/boot/dts/freescale/imx8mn-var-som-fulfil-lfp.dts | 5 ++---
 arch/arm64/boot/dts/freescale/imx8mn-var-som.dtsi           | 2 +-
 arch/arm64/configs/imx8_var_defconfig                       | 5 +++++
 3 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mn-var-som-fulfil-lfp.dts b/arch/arm64/boot/dts/freescale/imx8mn-var-som-fulfil-lfp.dts
index 8a394b631882..66f3af8a238f 100644
--- a/arch/arm64/boot/dts/freescale/imx8mn-var-som-fulfil-lfp.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mn-var-som-fulfil-lfp.dts
@@ -76,6 +76,7 @@ MX8MN_IOMUXC_GPIO1_IO11_GPIO1_IO11		0x14
 			MX8MN_IOMUXC_GPIO1_IO12_GPIO1_IO12		0x14
 			MX8MN_IOMUXC_GPIO1_IO14_GPIO1_IO14	 	0x14
 			MX8MN_IOMUXC_GPIO1_IO15_GPIO1_IO15		0x14
+			MX8MN_IOMUXC_ENET_MDIO_GPIO1_IO17		0x14
 			MX8MN_IOMUXC_SD2_DATA0_GPIO2_IO15		0x14
 			MX8MN_IOMUXC_SD2_DATA1_GPIO2_IO16		0x14
 			MX8MN_IOMUXC_SD2_DATA2_GPIO2_IO17		0x14
@@ -159,7 +160,6 @@ MX8MN_IOMUXC_ECSPI1_SCLK_ECSPI1_SCLK		0x13
 				MX8MN_IOMUXC_ECSPI1_MOSI_ECSPI1_MOSI		0x13
 				MX8MN_IOMUXC_ECSPI1_MISO_ECSPI1_MISO		0x13
 				MX8MN_IOMUXC_GPIO1_IO00_GPIO1_IO0		0x13
-				MX8MN_IOMUXC_ENET_MDIO_GPIO1_IO17		0x13
 				MX8MN_IOMUXC_SD2_RESET_B_GPIO2_IO19		0x13
 				MX8MN_IOMUXC_ENET_TX_CTL_GPIO1_IO22		0x13
 			>;
@@ -179,8 +179,7 @@ &ecspi1 {
     pinctrl-names = "default";
     pinctrl-0     = <&pinctrl_ecspi1>;
 	cs-gpios = <&gpio1 22 GPIO_ACTIVE_LOW>,
-			<&gpio1  0 GPIO_ACTIVE_LOW>,
-			<&gpio1 17 GPIO_ACTIVE_LOW>;
+			<&gpio1  0 GPIO_ACTIVE_LOW>;
 	/delete-node/ ads7846@0;
 	/delete-node/ spidev@2;
     /*/delete-property/ dmas;
diff --git a/arch/arm64/boot/dts/freescale/imx8mn-var-som.dtsi b/arch/arm64/boot/dts/freescale/imx8mn-var-som.dtsi
index cfaef77a6510..9d199d7f47ca 100644
--- a/arch/arm64/boot/dts/freescale/imx8mn-var-som.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mn-var-som.dtsi
@@ -172,7 +172,7 @@ spidev@2 {
 		reg = <2>;
 		compatible = "var,spidev";
 		spi-max-frequency = <12000000>;
-		status = "okay";
+		status = "disabled";
 	};
 };
 
diff --git a/arch/arm64/configs/imx8_var_defconfig b/arch/arm64/configs/imx8_var_defconfig
index fde9295b32f2..b8d0b1015460 100644
--- a/arch/arm64/configs/imx8_var_defconfig
+++ b/arch/arm64/configs/imx8_var_defconfig
@@ -120,6 +120,10 @@ CONFIG_NETFILTER_XT_MATCH_BPF=m
 CONFIG_NETFILTER_XT_MATCH_COMMENT=y
 CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
 CONFIG_NETFILTER_XT_MATCH_IPVS=m
+CONFIG_IP_SET=y
+CONFIG_IP_SET_HASH_IP=y
+CONFIG_IP_SET_HASH_IPPORT=y
+CONFIG_IP_SET_HASH_NET=y
 CONFIG_IP_VS=m
 CONFIG_IP_VS_PROTO_TCP=y
 CONFIG_IP_VS_PROTO_UDP=y
@@ -143,6 +147,7 @@ CONFIG_IP6_NF_MANGLE=m
 CONFIG_IP6_NF_NAT=m
 CONFIG_IP6_NF_TARGET_MASQUERADE=m
 CONFIG_NF_TABLES_BRIDGE=m
+CONFIG_NF_CONNTRACK_BRIDGE=m
 CONFIG_BRIDGE_NF_EBTABLES=m
 CONFIG_BRIDGE=y
 CONFIG_BRIDGE_VLAN_FILTERING=y
-- 
2.34.1

