[Unit]
Description=First Boot Bootstrapping Script
ConditionPathExists=/opt/fulfil/lfp/firstboot.sh
#so we ignore when running on sd card
ConditionPathExists=!/usr/bin/install_debian.sh

[Service]
EnvironmentFile=/etc/environment
Type=oneshot
ExecStart=/opt/fulfil/lfp/firstboot.sh
TimeoutSec=3600
Restart=on-abnormal
